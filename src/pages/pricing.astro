---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { pricing, pricingDisplay, formatPrice, estimateMonthlyCost } from '../config/pricing';
import { site, trialHref, trialLabel } from '../config/site';
import '../styles/pricing.css';
const presets = [100, 500, 2000];
const faqs = [
  { question: 'What does the standard service include?', answer: 'The standard offer includes setup, unlimited users and technical support. Before you start, confirm your retailer connections, mapping and testing responsibilities, software integration scope, support hours and any third-party charges in writing. Bespoke work needs an agreed scope.' },
  { question: 'What counts as a document?', answer: 'Purchase orders, order responses, despatch advice and invoices are separate business documents. An order can generate several documents in both directions. Confirm the billable-document policy, including technical acknowledgements, retries, duplicates, test traffic and failed exchanges, before estimating your live bill.' },
  { question: 'What will I pay in a quiet month?', answer: `At zero billable documents, the standard monthly service fee is ${pricingDisplay.monthlyFee}, excluding VAT. Document usage is charged in addition to that fee. The calculator shows the recurring standard price, rather than trial or enterprise terms.` },
  { question: `How does the ${pricing.standard.trialDays}-day trial work?`, answer: `Ask about the ${pricing.standard.trialDays}-day trial when discussing your connection. Availability, included work and usage, payment requirements, the start date, cancellation and the post-trial charges must be confirmed before it begins. Retailer testing and approval can affect when a connection goes live.` },
  { question: `What does the ${pricing.switchingOffer.freeDays}-day switching offer cover?`, answer: `The advertised switching offer provides ${pricing.switchingOffer.freeDays} free days for eligible migrations. Ask us to confirm eligibility, which charges and migration tasks are included, and whether it replaces the standard trial. Third-party costs, testing and cutover responsibilities need to be agreed; the offers are not assumed to be cumulative.` },
  { question: 'Is there a setup fee or annual commitment?', answer: 'The standard offer has no setup fee or annual contract. Confirm cancellation timing and any separate integration work before starting. Enterprise agreements can have different terms to reflect the agreed requirements.' },
  { question: 'When should I discuss a volume agreement?', answer: 'If you expect regular higher volumes, seasonal peaks, several business units or complex integrations, request a tailored estimate. Compare the proposed scope and total bill with the standard calculation before choosing.' },
];
---
<BaseLayout title={`EDI Spark pricing — ${pricingDisplay.monthlyFee}/month + ${pricingDisplay.documentFee}/document`} description={`Calculate your EDI costs: ${pricingDisplay.monthlyFee} per month plus ${pricingDisplay.documentFee} per document, excluding VAT. Review scope, trial and enterprise options.`}>
  <SiteHeader current="/pricing" />
  <main id="main-content" class="pricing-page">
    <section class="pricing-hero" aria-labelledby="pricing-hero-title">
      <div class="pricing-hero__copy">
        <h1 id="pricing-hero-title">Price your retailer EDI.</h1>
        <dl class="standard-rates" aria-label="Standard supplier rates">
          <div><dt>Monthly service</dt><dd>{pricingDisplay.monthlyFee}</dd></div>
          <div><dt>Per document</dt><dd>{pricingDisplay.documentFee}</dd></div>
        </dl>
        <p class="pricing-rate-note">Standard setup included. No annual contract. Prices exclude VAT.</p>
      </div>
      <section class="estimator" data-price-estimator aria-labelledby="estimator-title">
        <div class="estimator__heading"><h2 id="estimator-title">Monthly cost estimate</h2><p>Standard recurring price, excluding VAT</p></div>
        <noscript><p class="estimator-help">This example uses {pricing.estimator.defaultDocuments} documents. Enable JavaScript to adjust the calculator, or use the worked estimates below.</p><style>.estimator__controls{display:none!important}</style></noscript>
        <div class="estimator__controls">
          <div class="estimator__label-row">
            <label for="document-volume-number">Documents per month</label>
            <input id="document-volume-number" name="document-volume-number" type="number" min="0" step="1" value={pricing.estimator.defaultDocuments} inputmode="numeric" aria-describedby="volume-help estimate-error" data-volume-number />
          </div>
          <label class="sr-only" for="document-volume">Adjust monthly document volume</label>
          <input id="document-volume" type="range" min="0" max={pricing.estimator.maximumDocuments} step={pricing.estimator.step} value={pricing.estimator.defaultDocuments} aria-describedby="volume-help" data-volume-range />
          <div class="estimator__range-labels" aria-hidden="true"><span>0</span><span>{pricing.estimator.maximumDocuments.toLocaleString('en-GB')}</span></div>
          <p id="volume-help" class="estimator-help">Count documents sent and received. For more than {pricing.estimator.maximumDocuments.toLocaleString('en-GB')}, type the amount above.</p>
          <div class="estimate-presets" role="group" aria-label="Example volumes">
            {presets.map((volume) => <button type="button" aria-label={`${volume.toLocaleString('en-GB')} documents`} aria-pressed={volume === pricing.estimator.defaultDocuments ? 'true' : 'false'} data-volume-preset={volume}>{volume.toLocaleString('en-GB')}<span> documents</span></button>)}
          </div>
          <p id="estimate-error" class="estimate-error" role="status" data-estimate-error></p>
        </div>
        <dl class="estimator__breakdown">
          <div class="estimator__row"><dt>Monthly service</dt><dd>{pricingDisplay.monthlyFee}</dd></div>
          <div class="estimator__row"><dt>Document usage <small data-usage-formula>{pricing.estimator.defaultDocuments} × {pricingDisplay.documentFee}</small></dt><dd data-usage-fee>{formatPrice(pricing.estimator.defaultDocuments * pricing.standard.documentFee)}</dd></div>
        </dl>
        <div class="estimator__total"><span id="estimate-total-label">Monthly total <small>ex VAT</small></span><output for="document-volume document-volume-number" aria-labelledby="estimate-total-label" data-total>{formatPrice(estimateMonthlyCost(pricing.estimator.defaultDocuments))}</output></div>
        <p class="estimator__message" data-estimator-message>Confirm your integration scope and billable-document policy before starting.</p>
        <div class="estimator__actions"><a class="button estimator__cta" href={trialHref} data-cta="trial">{trialLabel}</a><a href="/contact?intent=enterprise" data-cta="enterprise">Ask about volume pricing</a></div>
      </section>
    </section>
    <section class="pricing-section price-examples" aria-labelledby="examples-title">
      <div>
        <h2 id="examples-title">Compare a quiet month with a busy one.</h2>
        <p>An order, a despatch advice and an invoice count as three separate documents. Check your retailer’s workflow and the billing policy when estimating usage.</p>
        <a href="/guides/edi-costs">Read the EDI cost guide</a>
      </div>
      <div class="price-example-table">
        <table>
          <caption>Standard monthly estimates</caption>
          <thead><tr><th scope="col">Documents</th><th scope="col">Service fee</th><th scope="col">Total ex VAT</th></tr></thead>
          <tbody>{[0, ...presets].map((documents) => <tr><th scope="row">{documents.toLocaleString('en-GB')}</th><td>{pricingDisplay.monthlyFee}</td><td>{formatPrice(estimateMonthlyCost(documents))}</td></tr>)}</tbody>
        </table>
        <p>Figures exclude separately agreed third-party or bespoke integration costs.</p>
      </div>
    </section>
    <section class="pricing-section pricing-routes" aria-labelledby="plans-title">
      <h2 id="plans-title">Choose the scope that fits.</h2>
      <div class="pricing-route-list">
        <article>
          <h3>Managed supplier EDI</h3>
          <p>Standard pricing for suppliers beginning retailer EDI. Discuss your connection, the {pricing.standard.trialDays}-day trial and the work included before you start.</p>
          <a class="button" href={trialHref} data-cta="trial">{trialLabel}</a>
        </article>
        <article>
          <h3>Enterprise and regular volume</h3>
          <p>For larger networks or tailored integration and service terms. Request a proposal based on expected and peak usage.</p>
          <a class="button button--outline" href="/enterprise">Explore enterprise EDI</a>
        </article>
      </div>
      <p class="developer-pricing-route">Evaluating APIs or automation? <a href={site.sandboxUrl ?? '/contact?intent=developer'} data-cta="developer">{site.sandboxUrl ? 'Open the developer sandbox' : 'Discuss developer test access'}</a> or <a href="/developers">review the technical evaluation guide</a>.</p>
    </section>
    <section class="switch-offer" aria-labelledby="switch-title">
      <h2 id="switch-title">Switching providers? Ask about {pricing.switchingOffer.freeDays} days free.</h2>
      <div><p>Confirm eligibility, included work and trial overlap before onboarding. Agree testing and cutover responsibilities before changing a live route.</p><a class="button button--outline" href="/contact?intent=switching" data-cta="switching">Discuss a switch</a></div>
    </section>
    <section class="pricing-section pricing-terms" aria-labelledby="terms-title">
      <div><h2 id="terms-title">Questions about pricing and terms.</h2><a href="/terms">Read service information</a></div>
      <div class="pricing-faqs">{faqs.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div>
    </section>
    <section class="pricing-cta" aria-labelledby="pricing-cta-title">
      <div><h2 id="pricing-cta-title">Put a clear scope behind the price.</h2><p>Bring your retailer, software and expected volume.</p></div>
      <a class="button" href={trialHref} data-cta="trial">{trialLabel}</a>
    </section>
  </main><SiteFooter />
  <script>
    import { pricing, estimateMonthlyCost, formatPrice } from '../config/pricing';
    import { track } from '../lib/analytics';
    const estimator = document.querySelector<HTMLElement>('[data-price-estimator]');
    if (estimator) {
      const range = estimator.querySelector<HTMLInputElement>('[data-volume-range]')!;
      const number = estimator.querySelector<HTMLInputElement>('[data-volume-number]')!;
      const total = estimator.querySelector<HTMLOutputElement>('[data-total]')!;
      const usage = estimator.querySelector<HTMLElement>('[data-usage-fee]')!;
      const formula = estimator.querySelector<HTMLElement>('[data-usage-formula]')!;
      const error = estimator.querySelector<HTMLElement>('[data-estimate-error]')!;
      const message = estimator.querySelector<HTMLElement>('[data-estimator-message]')!;
      const presets = [...estimator.querySelectorAll<HTMLButtonElement>('[data-volume-preset]')];
      const update = (rawValue: string) => {
        const value = Number(rawValue);
        try {
          if (!rawValue.trim()) throw new RangeError('Enter a whole number of documents to see an estimate.');
          const cost = estimateMonthlyCost(value);
          number.setCustomValidity('');
          number.removeAttribute('aria-invalid');
          error.textContent = '';
          range.value = String(Math.min(value, pricing.estimator.maximumDocuments));
          usage.textContent = formatPrice(cost - pricing.standard.monthlyFee);
          formula.textContent = `${value.toLocaleString('en-GB')} × ${formatPrice(pricing.standard.documentFee)}`;
          total.textContent = formatPrice(cost);
          message.textContent = value > pricing.estimator.maximumDocuments
            ? 'This is the full standard-rate estimate for your entered volume. Ask about a tailored volume agreement.'
            : value === 0 ? `At zero documents, the ${formatPrice(pricing.standard.monthlyFee)} monthly service fee still applies.`
            : 'Confirm your integration scope and billable-document policy before starting.';
          presets.forEach((button) => button.setAttribute('aria-pressed', String(Number(button.dataset.volumePreset) === value)));
          return value;
        } catch (issue) {
          const text = issue instanceof Error ? issue.message : 'Enter a valid document volume.';
          number.setCustomValidity(text);
          number.setAttribute('aria-invalid', 'true');
          error.textContent = text;
          total.textContent = '—';
          usage.textContent = '—';
          formula.textContent = '';
          message.textContent = 'The monthly total will appear when the volume is valid.';
          presets.forEach((button) => button.setAttribute('aria-pressed', 'false'));
          return null;
        }
      };
      const measure = (value: number | null) => {
        if (value === null) return;
        track('pricing_estimate_completed', { volume_band: value === 0 ? '0' : value <= 100 ? '1-100' : value <= 500 ? '101-500' : value <= 2000 ? '501-2000' : value <= 5000 ? '2001-5000' : '5001+', estimated_total: estimateMonthlyCost(value) });
      };
      number.addEventListener('input', () => update(number.value));
      number.addEventListener('change', () => measure(update(number.value)));
      range.addEventListener('input', () => { number.value = range.value; update(range.value); });
      range.addEventListener('change', () => measure(update(range.value)));
      presets.forEach((button) => button.addEventListener('click', () => { number.value = button.dataset.volumePreset!; measure(update(number.value)); }));
      update(number.value);
    }
  </script>
</BaseLayout>
