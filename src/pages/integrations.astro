---
import BaseLayout from '../layouts/BaseLayout.astro';
import { integrationCategories, integrations } from '../data/integrations';
import '../styles/integrations.css';

const trialUrl = 'https://example.com/edi-spark/start-free';
const demoUrl = 'https://example.com/edi-spark/book-demo';
const signInUrl = 'https://example.com/edi-spark/sign-in';

const navigation = [
  { label: 'Product', href: '/#product' },
  { label: 'Solutions', href: '/#solutions' },
  { label: 'Partners', href: '/partners' },
  { label: 'Developers', href: '/developers' },
  { label: 'Integrations', href: '/integrations', current: true },
  { label: 'Pricing', href: '/pricing' },
];

const categoryCounts = new Map(
  integrationCategories.map((category) => [
    category,
    integrations.filter((integration) => integration.category === category).length,
  ]),
);

const markFor = (name: string) => name
  .split(/\s+/)
  .filter((part) => !['&', 'for', 'Online'].includes(part))
  .slice(0, 2)
  .map((part) => part[0])
  .join('')
  .toUpperCase();
---

<BaseLayout
  title="Business integrations — EDI Spark"
  description="Connect EDI Spark to ERP, accounting, commerce, procurement, document, logistics and automation systems through 800+ available integrations."
>
  <header class="site-header" data-header>
    <a class="brand" href="/" aria-label="EDI Spark home">
      <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      <span>EDI Spark</span>
    </a>

    <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-navigation" data-menu-button>
      <span class="sr-only">Open navigation</span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>

    <nav id="site-navigation" class="site-navigation" aria-label="Primary navigation" data-navigation>
      <div class="nav-links">
        {navigation.map((item) => (
          <a href={item.href} aria-current={item.current ? 'page' : undefined}>{item.label}</a>
        ))}
      </div>
      <div class="nav-actions">
        <a class="text-link" href={signInUrl}>Sign in</a>
        <a class="button button--compact" href={trialUrl}>Start free</a>
      </div>
    </nav>
  </header>

  <main id="main-content" class="integrations-page">
    <section class="integrations-hero" aria-labelledby="integrations-title">
      <div class="integrations-hero__copy">
        <p class="integrations-context">Business integrations</p>
        <h1 id="integrations-title">Your systems, connected to every exchange.</h1>
        <p class="integrations-hero__lede">
          Connect the tools that run your business to every order, invoice, dispatch notice and
          inventory update. Choose from 800+ available connections—or bring your own API.
        </p>
        <div class="button-group">
          <a class="button" href="#directory">Browse integrations</a>
          <a class="button button--hero-outline" href={trialUrl}>Start free</a>
        </div>
      </div>

      <div class="exchange-rail" aria-label="Sell, operations, accounting and shipping systems connect through EDI Spark">
        <div class="rail-node rail-node--sell">
          <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M4 6h3l3 14h13l3-9H9M12 26h.01M23 26h.01" /></svg>
          <span>Sell</span>
        </div>
        <div class="rail-node rail-node--operate">
          <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M5 27V10l11-5 11 5v17M10 27v-8h12v8M10 13h2M15 13h2M20 13h2" /></svg>
          <span>Operate</span>
        </div>
        <div class="rail-core" aria-label="EDI Spark">
          <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        </div>
        <div class="rail-node rail-node--account">
          <svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="11" /><path d="M19.5 11.5c-1-1-6-1.5-6 1.5 0 4 7 2 7 6 0 3-5.5 3.5-8 1.5M16 7v4M16 21v4" /></svg>
          <span>Account</span>
        </div>
        <div class="rail-node rail-node--ship">
          <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M3 8h16v14H3zM19 13h5l5 5v4H19zM8 25a3 3 0 1 0 0-.1M24 25a3 3 0 1 0 0-.1" /></svg>
          <span>Ship</span>
        </div>
        <div class="rail-line" aria-hidden="true"><span></span><i></i><i></i><i></i></div>
        <p>Orders <i></i> Invoices <i></i> Dispatch <i></i> Inventory</p>
      </div>
    </section>

    <section class="integration-directory" id="directory" aria-labelledby="directory-title" data-integration-directory>
      <div class="directory-intro">
        <div>
          <h2 id="directory-title">Find your system</h2>
          <p>A focused selection for EDI, documents and B2B operations.</p>
        </div>
        <p class="integration-count" aria-live="polite" data-integration-count>
          <strong>{integrations.length}</strong> useful integrations shown
        </p>
      </div>

      <div class="integration-browser">
        <aside class="integration-filters" aria-label="Integration filters">
          <div class="integration-search">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg>
            <label class="sr-only" for="integration-search">Search integrations</label>
            <input id="integration-search" type="search" placeholder="Search systems or use cases" autocomplete="off" data-integration-search />
            <button type="button" hidden data-clear-integration-search>Clear</button>
          </div>

          <div class="category-list" role="group" aria-label="Filter by category">
            <button type="button" aria-pressed="true" data-integration-category="all">
              <span>All integrations</span><strong>{integrations.length}</strong>
            </button>
            {integrationCategories.map((category) => (
              <button type="button" aria-pressed="false" data-integration-category={category}>
                <span>{category}</span><strong>{categoryCounts.get(category)}</strong>
              </button>
            ))}
          </div>

          <div class="custom-connection">
            <span aria-hidden="true">{`{ }`}</span>
            <div>
              <strong>Not listed?</strong>
              <p>We can still connect it.</p>
            </div>
            <a href={demoUrl} aria-label="Discuss a custom connection">→</a>
          </div>
        </aside>

        <div class="integration-results">
          <div class="results-heading" aria-hidden="true">
            <span>System</span><span>Use case</span><span>Capabilities</span><span>Status</span>
          </div>

          <div class="integration-rows" data-integration-rows>
            {integrations.map((integration) => (
              <article
              class="system-row"
                data-integration-row
                data-integration-name={integration.name.toLocaleLowerCase('en-GB')}
                data-category={integration.category}
                data-search={`${integration.name} ${integration.category} ${integration.description} ${integration.capabilities.join(' ')}`.toLocaleLowerCase('en-GB')}
              >
                <div class="integration-identity">
                  <span class="integration-mark" aria-hidden="true">{markFor(integration.name)}</span>
                  <div><h3>{integration.name}</h3><small>{integration.category}</small></div>
                </div>
                <p>{integration.description}</p>
                <ul aria-label={`${integration.name} capabilities`}>
                  {integration.capabilities.map((capability) => <li>{capability}</li>)}
                </ul>
                <span class="integration-status"><i></i>Available</span>
              </article>
            ))}
          </div>

          <div class="integration-empty" hidden data-integration-empty>
            <h3>No route showing—yet.</h3>
            <p>Try another term or clear the category. Your system can still connect through its API or files.</p>
            <button type="button" data-reset-integrations>Clear filters</button>
          </div>
        </div>
      </div>
    </section>

    <section class="connection-options" aria-labelledby="connection-options-title">
      <div class="connection-options__intro">
        <h2 id="connection-options-title">Any system. One clear exchange.</h2>
        <p>
          A named connector is only one route. EDI Spark can meet your applications through the
          interface they already expose, while keeping mapping and partner rules in one place.
        </p>
      </div>
      <div class="connection-methods">
        <article><strong>REST APIs & webhooks</strong><p>Send structured data and react to document events in real time.</p></article>
        <article><strong>Files & cloud storage</strong><p>Exchange CSV, XML, JSON and business files through managed storage routes.</p></article>
        <article><strong>Automation platforms</strong><p>Use Workato, Make, n8n, Zapier or your own orchestration layer.</p></article>
        <article><strong>Private applications</strong><p>Connect internal and industry-specific systems with authenticated APIs.</p></article>
      </div>
    </section>

    <section class="integrations-cta" aria-labelledby="integrations-cta-title">
      <div>
        <p>Ready to connect your stack?</p>
        <h2 id="integrations-cta-title">Start exchanging documents in days, not months.</h2>
      </div>
      <div class="integrations-cta__actions">
        <a class="button button--ink" href={trialUrl}>Start free for 30 days</a>
        <a class="text-arrow text-arrow--ink" href={demoUrl}>Book a demo <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <a class="brand brand--footer" href="/">EDI Spark</a>
    <p>Effortless EDI for suppliers connecting to retailers.</p>
    <div class="footer-links">
      <a href="https://example.com/edi-spark/privacy">Privacy</a>
      <a href="https://example.com/edi-spark/terms">Terms</a>
      <a href={signInUrl}>Sign in</a>
    </div>
  </footer>

  <script>
    const menuButton = document.querySelector('[data-menu-button]');
    const navigation = document.querySelector('[data-navigation]');

    const setMenu = (open) => {
      if (!(menuButton instanceof HTMLButtonElement) || !(navigation instanceof HTMLElement)) return;
      menuButton.setAttribute('aria-expanded', String(open));
      const label = menuButton.querySelector('.sr-only');
      if (label) label.textContent = open ? 'Close navigation' : 'Open navigation';
      navigation.dataset.open = String(open);
      document.body.classList.toggle('menu-open', open);
    };

    menuButton?.addEventListener('click', () => setMenu(menuButton.getAttribute('aria-expanded') !== 'true'));
    navigation?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));
    window.addEventListener('keydown', (event) => { if (event.key === 'Escape') setMenu(false); });

    const directory = document.querySelector('[data-integration-directory]');
    if (directory instanceof HTMLElement) {
      const search = directory.querySelector('[data-integration-search]');
      const clearSearch = directory.querySelector('[data-clear-integration-search]');
      const categoryButtons = [...directory.querySelectorAll('[data-integration-category]')];
      const rows = [...directory.querySelectorAll('[data-integration-row]')];
      const count = directory.querySelector('[data-integration-count]');
      const empty = directory.querySelector('[data-integration-empty]');
      const reset = directory.querySelector('[data-reset-integrations]');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let activeCategory = 'all';

      const signalUpdate = () => {
        if (reduceMotion.matches) return;
        const visibleRows = rows.filter((row) => row instanceof HTMLElement && !row.hidden).slice(0, 8);
        visibleRows.forEach((row, index) => {
          if (!(row instanceof HTMLElement)) return;
          row.classList.remove('is-filtered-in');
          row.style.setProperty('--row-delay', `${index * 35}ms`);
          void row.offsetWidth;
          row.classList.add('is-filtered-in');
          row.addEventListener('animationend', () => row.classList.remove('is-filtered-in'), { once: true });
        });
        if (count instanceof HTMLElement) {
          count.classList.remove('is-updated');
          void count.offsetWidth;
          count.classList.add('is-updated');
          count.addEventListener('animationend', () => count.classList.remove('is-updated'), { once: true });
        }
      };

      const updateDirectory = () => {
        const query = search instanceof HTMLInputElement ? search.value.trim().toLocaleLowerCase('en-GB') : '';
        let visible = 0;

        rows.forEach((row) => {
          if (!(row instanceof HTMLElement)) return;
          const matchesCategory = activeCategory === 'all' || row.dataset.category === activeCategory;
          const matchesSearch = !query || (row.dataset.search ?? '').includes(query);
          row.hidden = !(matchesCategory && matchesSearch);
          row.classList.toggle('is-exact-match', Boolean(query) && row.dataset.integrationName === query);
          if (!row.hidden) visible += 1;
        });

        if (count) count.innerHTML = `<strong>${visible}</strong> ${visible === 1 ? 'useful integration' : 'useful integrations'} shown`;
        if (empty instanceof HTMLElement) empty.hidden = visible !== 0;
        if (clearSearch instanceof HTMLButtonElement) clearSearch.hidden = !query;
        signalUpdate();
      };

      search?.addEventListener('input', updateDirectory);
      clearSearch?.addEventListener('click', () => {
        if (!(search instanceof HTMLInputElement)) return;
        search.value = '';
        search.focus();
        updateDirectory();
      });
      categoryButtons.forEach((button) => button.addEventListener('click', () => {
        if (!(button instanceof HTMLButtonElement)) return;
        activeCategory = button.dataset.integrationCategory ?? 'all';
        categoryButtons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
        updateDirectory();
      }));
      reset?.addEventListener('click', () => {
        activeCategory = 'all';
        categoryButtons.forEach((item, index) => item.setAttribute('aria-pressed', String(index === 0)));
        if (search instanceof HTMLInputElement) search.value = '';
        updateDirectory();
        search?.focus();
      });
    }
  </script>
</BaseLayout>
