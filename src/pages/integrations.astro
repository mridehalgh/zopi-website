---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { pricing } from '../config/pricing';
import { demoHref, site, trialHref, trialLabel } from '../config/site';
import { integrationCategories, integrations } from '../data/integrations';
import '../styles/integrations.css';

const categoryCounts = new Map(
  integrationCategories.map((category) => [
    category,
    integrations.filter((integration) => integration.category === category).length,
  ]),
);

const markFor = (name: string) => name
  .split(/\s+/)
  .filter((part) => !['&', 'for', 'Online'].includes(part))
  .slice(0, 2)
  .map((part) => part[0])
  .join('')
  .toUpperCase();
---

<BaseLayout
  title="Business integrations — EDI Spark"
  description="Explore business systems and ask us to assess the integration route, supported documents and setup requirements for your workflow."
>
  <SiteHeader current="/integrations" />

  <main id="main-content" class="integrations-page">
    <section class="integrations-hero" aria-labelledby="integrations-title">
      <div class="integrations-hero__copy">
        <h1 id="integrations-title">Find the right EDI connection.</h1>
        <p class="integrations-hero__lede">
          Find your business system and tell us your product version and workflow.
          We’ll assess how it could exchange orders, invoices, despatch notices and inventory.
        </p>
        <div class="button-group">
          <a class="button" href="#directory">Browse integrations</a>
          <a class="button button--hero-outline" href={trialHref} data-cta="trial">{site.trialUrl ? trialLabel : 'Discuss a trial'}</a>
        </div>
      </div>

      <dl class="integration-manifest">
        <div><dt>Document flows</dt><dd>Orders, invoices, despatch notices, inventory</dd></div>
        <div><dt>Connection routes</dt><dd>API, files, automation or private applications</dd></div>
      </dl>
    </section>

    <section class="integration-directory" id="directory" aria-labelledby="directory-title" data-integration-directory>
      <div class="directory-intro">
        <h2 id="directory-title">Find your system</h2>
        <p class="integration-count" aria-live="polite" data-integration-count>
          <strong data-integration-number>{integrations.length}</strong> <span data-integration-label>systems listed</span>
        </p>
      </div>

      <div class="integration-browser">
        <div class="integration-filters" role="search" aria-label="Find an integration" hidden data-integration-tools>
          <div class="integration-search">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg>
            <label class="sr-only" for="integration-search">Search integrations</label>
            <input id="integration-search" type="search" placeholder="Search systems or use cases" autocomplete="off" data-integration-search />
            <button type="button" hidden data-clear-integration-search>Clear</button>
          </div>

          <label class="integration-category">
            <span>Category</span>
            <select data-integration-category>
              <option value="all">All systems ({integrations.length})</option>
              {integrationCategories.map((category) => (
                <option value={category}>{category} ({categoryCounts.get(category)})</option>
              ))}
            </select>
          </label>
        </div>

        <p class="integration-listing-note">Listings describe potential use cases for EDI and B2B operations. Compatibility and scope require assessment before a connector can be confirmed.</p>

        <div class="integration-results">
          <div class="results-heading" aria-hidden="true">
            <span>System</span><span>Use case</span><span>Potential document flows</span><span>Next step</span>
          </div>

          <div class="integration-rows" data-integration-rows>
            {integrations.map((integration) => (
              <article
                class="system-row"
                data-integration-row
                data-integration-name={integration.name.toLocaleLowerCase('en-GB')}
                data-category={integration.category}
                data-search={`${integration.name} ${integration.category} ${integration.description} ${integration.capabilities.join(' ')}`.toLocaleLowerCase('en-GB')}
              >
                <div class="integration-identity">
                  <span class="integration-mark" aria-hidden="true">{markFor(integration.name)}</span>
                  <div><h3>{integration.name}</h3><small>{integration.category}</small></div>
                </div>
                <p>{integration.description}</p>
                <ul aria-label={`${integration.name} potential document flows`}>
                  {integration.capabilities.map((capability) => <li>{capability}</li>)}
                </ul>
                <a
                  class="integration-status"
                  href={`/contact?intent=connection&connection=${encodeURIComponent(integration.name)}`}
                  data-analytics-event="directory_item_selected"
                  data-directory="integrations"
                  data-item-slug={integration.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}
                  aria-label={`Request assessment for ${integration.name}`}
                >Request assessment</a>
              </article>
            ))}
          </div>

          <div class="integration-empty" hidden data-integration-empty>
            <h3>No matching systems</h3>
            <p>Try another term or clear the category. Ask us to review your system’s API or file options.</p>
            <a href="/contact?intent=connection">Ask about your system</a>
            <button type="button" data-reset-integrations>Clear filters</button>
          </div>
        </div>
      </div>
      <p class="custom-connection">Can’t find your system? <a href="/contact?intent=connection">Ask about a custom connection</a></p>
    </section>

    <section class="connection-options" aria-labelledby="connection-options-title">
      <div class="connection-options__intro">
        <h2 id="connection-options-title">Choose a route that fits your system.</h2>
        <p>
          A connection may use a native connector, an automation platform or a custom API or file route.
          We need to confirm the method, document directions and implementation work for your setup.
        </p>
      </div>
      <div class="connection-methods">
        <article><strong>REST APIs & webhooks</strong><p>Check authentication, supported endpoints and event handling for your workflow.</p></article>
        <article><strong>Files & cloud storage</strong><p>Confirm file formats, transfer methods and import or export schedules.</p></article>
        <article><strong>Automation platforms</strong><p>Assess third-party platforms and any separate subscription or usage charges.</p></article>
        <article><strong>Private applications</strong><p>Review access, mapping and support responsibilities for custom systems.</p></article>
      </div>
    </section>

    <section class="integrations-cta" aria-labelledby="integrations-cta-title">
      <div>
        <h2 id="integrations-cta-title">Discuss the systems you need to connect.</h2>
      </div>
      <div class="integrations-cta__actions">
        <a class="button button--ink" href={trialHref} data-cta="trial">{site.trialUrl ? trialLabel : `Discuss a ${pricing.standard.trialDays}-day trial`}</a>
        <a class="text-arrow text-arrow--ink" href={demoHref} data-cta="demo">{site.bookingUrl ? 'Book a demo' : 'Discuss a demo'} <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </main>

  <SiteFooter />

  <script>
    import { track } from '../lib/analytics';
    const directory = document.querySelector('[data-integration-directory]');
    if (directory instanceof HTMLElement) {
      const search = directory.querySelector('[data-integration-search]');
      const clearSearch = directory.querySelector('[data-clear-integration-search]');
      const category = directory.querySelector('[data-integration-category]');
      const tools = directory.querySelector('[data-integration-tools]');
      if (tools instanceof HTMLElement) tools.hidden = false;
      const rows = [...directory.querySelectorAll('[data-integration-row]')];
      const count = directory.querySelector('[data-integration-number]');
      const countLabel = directory.querySelector('[data-integration-label]');
      const empty = directory.querySelector('[data-integration-empty]');
      const reset = directory.querySelector('[data-reset-integrations]');
      const updateDirectory = () => {
        const query = search instanceof HTMLInputElement ? search.value.trim().toLocaleLowerCase('en-GB') : '';
        const activeCategory = category instanceof HTMLSelectElement ? category.value : 'all';
        let visible = 0;

        rows.forEach((row) => {
          if (!(row instanceof HTMLElement)) return;
          const matchesCategory = activeCategory === 'all' || row.dataset.category === activeCategory;
          const matchesSearch = !query || (row.dataset.search ?? '').includes(query);
          row.hidden = !(matchesCategory && matchesSearch);
          row.classList.toggle('is-exact-match', Boolean(query) && row.dataset.integrationName === query);
          if (!row.hidden) visible += 1;
        });

        if (count) count.textContent = String(visible);
        if (countLabel) countLabel.textContent = visible === 1 ? 'system found' : 'systems found';
        if (empty instanceof HTMLElement) empty.hidden = visible !== 0;
        if (clearSearch instanceof HTMLButtonElement) clearSearch.hidden = !query;
      };

      search?.addEventListener('input', updateDirectory);
      let searchTimer: ReturnType<typeof setTimeout>;
      search?.addEventListener('input', () => {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(() => {
          track('directory_searched', { directory: 'integrations', result_count: directory.querySelectorAll('[data-integration-row]:not([hidden])').length });
        }, 600);
      });

      clearSearch?.addEventListener('click', () => {
        if (!(search instanceof HTMLInputElement)) return;
        search.value = '';
        search.focus();
        updateDirectory();
      });
      category?.addEventListener('change', updateDirectory);
      reset?.addEventListener('click', () => {
        if (category instanceof HTMLSelectElement) category.value = 'all';
        if (search instanceof HTMLInputElement) search.value = '';
        updateDirectory();
        search?.focus();
      });
    }
  </script>
</BaseLayout>
