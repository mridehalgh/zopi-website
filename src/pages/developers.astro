---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/developers.css';
import { site } from '../config/site';

const assessmentSteps = [
  ['Your retailer documents', 'Identify the document types, partner requirements and sample files your integration needs to handle.'],
  ['Your application model', 'Agree how retailer fields map into your application or UBL, including required fields and validation.'],
  ['Your delivery and recovery path', 'Review authentication, delivery status, retries and exception handling for the proposed connection.'],
  ['A testable route to production', 'Confirm the available interfaces, test access and acceptance checks before committing to a live integration.'],
];
const exampleJson = `{
  "orderId": "PO-123456",
  "currency": "GBP",
  "lines": [
    {
      "sku": "ABC-123",
      "quantity": 100
    }
  ]
}`;
const exampleUbl = `<Order>
  <cbc:ID>PO-123456</cbc:ID>
  <cbc:DocumentCurrencyCode>
    GBP
  </cbc:DocumentCurrencyCode>
  <cac:OrderLine>
    <cac:LineItem>
      <cbc:Quantity>100</cbc:Quantity>
    </cac:LineItem>
  </cac:OrderLine>
</Order>`;
---

<BaseLayout
  title="EDI integrations for developers — EDI Spark"
  description="Explore how retailer documents can map to your application or UBL. Discuss API access, test requirements and your integration with EDI Spark."
>
  <SiteHeader current="/developers" />
  <main id="main-content" class="developers-page">
    <section class="developer-hero" aria-labelledby="developer-hero-title">
      <div class="developer-hero__copy">
        <p class="developer-context">EDI Spark for developers</p>
        <h1 id="developer-hero-title">Retailer EDI.<br />Your data model.</h1>
        <p class="developer-hero__lede">
          Bring retailer documents into the applications you build. Start with your source files,
          target schema and the exchange your team needs to support.
        </p>
        <div class="button-group">
          <a class="button button--api" href="/contact?intent=technical">Discuss your integration</a>
          <a class="button button--outline" href="#mapping-example">See a mapping example</a>
        </div>
      </div>
      <div class="api-exchange" id="mapping-example" aria-labelledby="example-label">
        <div class="api-exchange__bar">
          <strong id="example-label">Illustrative mapping</strong>
          <span>JSON → UBL</span>
        </div>
        <div class="api-exchange__panes">
          <div class="code-pane">
            <span class="code-pane__label">Application JSON example</span>
            <pre><code>{exampleJson}</code></pre>
          </div>
          <div class="code-pane code-pane--response">
            <span class="code-pane__label">UBL order fragment</span>
            <pre><code>{exampleUbl}</code></pre>
          </div>
        </div>
        <div class="api-exchange__event">
          <p>Example fields only. This is not a complete UBL document or an API request contract.</p>
        </div>
      </div>
    </section>

    <section class="workflow-section" aria-labelledby="assessment-title">
      <div class="workflow-heading">
        <p class="developer-context">Plan the whole exchange</p>
        <h2 id="assessment-title">Agree the integration before writing the glue.</h2>
        <p>
          A working connection needs more than a payload. We assess the mapping, delivery and
          operational requirements with your team, including what happens when a document fails.
        </p>
      </div>
      <ol class="workflow-list">
        {assessmentSteps.map(([title, body], index) => (
          <li>
            <span>{index + 1}</span>
            <div><strong>{title}</strong><p>{body}</p></div>
            <i aria-hidden="true"></i>
          </li>
        ))}
      </ol>
    </section>

    <section class="endpoint-index" aria-labelledby="access-title">
      <div class="endpoint-index__heading">
        <p class="developer-context">Technical discovery</p>
        <h2 id="access-title">Get the details for your use case.</h2>
        <p>
          Tell us your stack, trading partners and document types. We can discuss the documentation
          and test access relevant to the proposed integration.
        </p>
      </div>
      <div class="endpoint-list">
        <a class="endpoint-row" href={site.docsUrl ?? '/contact?intent=developer'} data-cta="documentation">
          <strong>Documentation &amp; test access</strong>
          <span>Request the current integration details and discuss a test environment.</span>
          <span>{site.docsUrl ? 'Read documentation' : 'Request access'}</span><b aria-hidden="true">→</b>
        </a>
        <a class="endpoint-row" href="/contact?intent=technical">
          <strong>Agent workflows</strong>
          <span>Discuss A2A or MCP requirements, available access and approval boundaries.</span>
          <span>Discuss requirements</span><b aria-hidden="true">→</b>
        </a>
        <a class="endpoint-row" href="/enterprise">
          <strong>Larger integration programmes</strong>
          <span>Assess network, procurement and operational requirements together.</span>
          <span>Enterprise EDI</span><b aria-hidden="true">→</b>
        </a>
      </div>
    </section>

    <section class="developer-cta" aria-labelledby="developer-cta-title">
      <div>
        <p class="developer-context">Bring a sample document</p>
        <h2 id="developer-cta-title">Let’s map your next connection.</h2>
      </div>
      <div class="developer-cta__actions">
        <a class="button button--ink" href="/contact?intent=technical">Discuss your integration</a>
        <a class="text-arrow text-arrow--ink" href="/pricing">See pricing <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
