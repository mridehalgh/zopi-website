---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/enterprise.css';

const requirements = [
  { title: 'Trading network & volume', body: 'Which retailers and suppliers you trade with, the documents they require and your typical and peak monthly volumes.', href: '/partners', link: 'Browse trading partners' },
  { title: 'Business systems & mapping', body: 'The ERP, finance and warehouse systems involved, your source formats and any partner-specific validation rules.', href: '/integrations', link: 'Review integration options' },
  { title: 'Service & data requirements', body: 'Your support and escalation needs, data handling requirements and service levels for assessment.', href: '/security', link: 'Review security and service questions' },
  { title: 'Procurement & commercial terms', body: 'Your buying process, contract requirements and the cost of the proposed scope, including any implementation work.', href: '/pricing', link: 'See standard pricing' },
];
const stages = [
  ['Assess the scope', 'Share your partner list, system landscape, volumes and operating constraints. We review the proposed fit and identify questions to resolve.'],
  ['Agree a test plan', 'Define the documents, mappings, responsibilities and acceptance checks for the connections under consideration.'],
  ['Plan the changeover', 'If you are moving providers, agree the sequence, retailer dependencies and cutover checks before changing a live route.'],
];
---

<BaseLayout
  title="Enterprise retailer EDI — EDI Spark"
  description="Discuss EDI for larger trading networks. Assess integrations, volumes, service requirements, migration and tailored commercial terms with EDI Spark."
>
  <SiteHeader current="/enterprise" />
  <main id="main-content" class="enterprise-page">
    <section class="enterprise-hero" aria-labelledby="enterprise-title">
      <div>
        <h1 id="enterprise-title">Plan your enterprise EDI rollout.</h1>
        <p class="enterprise-lede">
          Bring your retailer connections, business systems and operating requirements together.
          We’ll assess the scope with your team before proposing an approach and commercial terms.
        </p>
        <div class="enterprise-actions">
          <a class="button" href="/contact?intent=enterprise" data-cta="enterprise">Discuss your requirements</a>
          <a href="/developers">For technical teams</a>
        </div>
      </div>
      <aside class="enterprise-brief" aria-labelledby="brief-title">
        <h2 id="brief-title">Start with your scope</h2>
        <dl>
          <div><dt>Trading</dt><dd>Partner list and document flows</dd></div>
          <div><dt>Systems</dt><dd>ERP, finance and warehouse systems</dd></div>
          <div><dt>Volume</dt><dd>Typical and peak usage</dd></div>
          <div><dt>Timing</dt><dd>Target dates and contract milestones</dd></div>
        </dl>
        <p>Bring what you know. Use anonymised examples when sharing document structure.</p>
      </aside>
    </section>

    <nav class="enterprise-jump" aria-label="On this page">
      <a href="#requirements-title">Requirements</a><a href="#rollout-title">Rollout stages</a><a href="#questions-title">Frequently asked questions</a>
    </nav>

    <section class="enterprise-section enterprise-scope" aria-labelledby="requirements-title">
      <div class="enterprise-section__heading">
        <h2 id="requirements-title">What we’ll review together.</h2>
        <p>
          Enterprise fit depends on your network and operating needs. These are the areas we review
          before confirming what can be delivered.
        </p>
      </div>
      <div class="enterprise-requirements">
        {requirements.map(({ title, body, href, link }) => (
          <article><h3>{title}</h3><div><p>{body}</p><a href={href}>{link}</a></div></article>
        ))}
      </div>
    </section>

    <section class="enterprise-section enterprise-rollout" aria-labelledby="rollout-title">
      <div class="enterprise-section__heading">
        <h2 id="rollout-title">From assessment to cutover.</h2>
        <p>
          Retailer testing, internal teams and existing contracts can all affect a change.
          A proposed rollout should account for each of them.
        </p>
      </div>
      <ol class="enterprise-stages">
        {stages.map(([title, body]) => (
          <li><h3>{title}</h3><p>{body}</p></li>
        ))}
      </ol>
    </section>

    <section class="enterprise-section enterprise-faq" aria-labelledby="questions-title">
      <div class="enterprise-section__heading">
        <h2 id="questions-title">Questions before you commit.</h2>
      </div>
      <div class="enterprise-questions">
        <details>
          <summary>When is enterprise pricing a better fit?</summary>
          <p>Discuss a tailored scope if you have higher volumes, several business units, a complex partner network or procurement requirements beyond the standard plan. We assess those requirements before offering terms.</p>
        </details>
        <details>
          <summary>Can we review our service and data requirements?</summary>
          <p>Yes. Share the requirements your team needs evaluated, including support, escalation and data handling. Any agreed commitments must be documented in the proposal and agreement.</p>
        </details>
        <details>
          <summary>Can we move from an existing EDI provider?</summary>
          <p>We can assess a migration with you. Bring your partner list, document flows, current setup and contract dates so the proposed test and cutover plan can account for dependencies.</p>
        </details>
        <details>
          <summary>What should we bring to the first conversation?</summary>
          <p>A partner and system list, approximate document volumes, target dates and any critical requirements are enough to begin. Use anonymised examples when discussing document structure.</p>
        </details>
      </div>
    </section>

    <section class="enterprise-close" aria-labelledby="enterprise-close-title">
      <h2 id="enterprise-close-title">Start with the requirements.</h2>
      <a class="button" href="/contact?intent=enterprise" data-cta="enterprise">Discuss your requirements</a>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
