---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pricing, pricingDisplay } from '../config/pricing';

const trialUrl = 'https://example.com/edi-spark/start-free';
const demoUrl = 'https://example.com/edi-spark/book-demo';
const signInUrl = 'https://example.com/edi-spark/sign-in';

const navigation = [
  { label: 'Product', href: '#product' },
  { label: 'Solutions', href: '#solutions' },
  { label: 'Developers', href: '/developers' },
  { label: 'Pricing', href: '/pricing' },
];

const integrationGroups = [
  ['Retailers', 'Major UK and EMEA networks'],
  ['Commerce', 'Storefronts and marketplaces'],
  ['Finance', 'Accounting and ERP platforms'],
  ['Operations', 'Warehouse and fulfilment tools'],
];

const mappingSteps = [
  {
    stage: 'Orders arrive',
    title: 'Stop checking retailer portals',
    body: 'New orders arrive automatically in one clear workspace, ready for your team to process.',
    item: 'Retailer purchase order',
    result: 'Ready to process',
  },
  {
    stage: 'Work stays in sync',
    title: 'Remove repetitive data entry',
    body: 'Connect the software you already use so order details move without copying, pasting or re-keying.',
    item: 'Sales order created',
    result: 'Synced automatically',
  },
  {
    stage: 'Issues stand out',
    title: 'Know what needs attention',
    body: 'When something needs fixing, your team sees a plain-English explanation and the next step.',
    item: 'Price mismatch found',
    result: 'Clear action provided',
  },
];

const businessOutcomes = [
  ['Onboard retailers sooner', 'Start exchanging documents without a long implementation project.'],
  ['Cut manual admin', 'Keep orders and invoices moving without portal hopping or re-keying.'],
  ['Catch problems earlier', 'Give your team one clear place to see status and resolve exceptions.'],
];

const transactions = [
  ['Purchase order', 'PO-10482', 'Ready'],
  ['Invoice', 'INV-8821', 'Delivered'],
  ['Order response', 'OR-10482', 'Ready'],
];
---

<BaseLayout
  title="EDI Spark — Super simple EDI for suppliers"
  description="Connect to UK and EMEA retailers, reduce manual order admin and start quickly—without setup fees or annual contracts."
>
  <header class="site-header" data-header>
    <a class="brand" href="#top" aria-label="EDI Spark home">
      <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      <span>EDI Spark</span>
    </a>

    <button
      class="menu-button"
      type="button"
      aria-expanded="false"
      aria-controls="site-navigation"
      data-menu-button
    >
      <span class="sr-only">Open navigation</span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>

    <nav id="site-navigation" class="site-navigation" aria-label="Primary navigation" data-navigation>
      <div class="nav-links">
        {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
      </div>
      <div class="nav-actions">
        <a class="text-link" href={signInUrl}>Sign in</a>
        <a class="button button--compact" href={trialUrl}>Start free</a>
      </div>
    </nav>
  </header>

  <main id="main-content">
    <section class="hero" id="top" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="hero-context">Retailer EDI, without the traditional overhead.</p>
        <h1 id="hero-title">Super simple EDI for suppliers.</h1>
        <p class="hero-lede">
          Connect to retailers without setup fees, annual contracts or prior EDI knowledge.
        </p>
        <div class="button-group">
          <a class="button" href={trialUrl}>Start free for {pricing.standard.trialDays} days</a>
          <a class="button button--outline" href={demoUrl}>Book a demo</a>
        </div>
        <p class="trial-note">No setup fee. No 12-month contract.</p>
      </div>

      <div class="hero-ledger" aria-label="EDI Spark pricing and document exchange overview">
        <div class="ledger-pricing">
          <div class="ledger-row">
            <span class="ledger-value">{pricingDisplay.monthlyFee}</span>
            <span class="ledger-unit">per month</span>
          </div>
          <div class="ledger-row">
            <span class="ledger-value">{pricingDisplay.documentFee}</span>
            <span class="ledger-unit">per document</span>
          </div>
          <div class="ledger-row ledger-row--plain">
            <span class="ledger-value">No</span>
            <span class="ledger-unit">setup fee</span>
          </div>
        </div>

        <div class="hero-route" aria-hidden="true">
          <div class="route-stop">
            <span class="route-icon">S</span>
            <span>Supplier</span>
          </div>
          <span class="route-line"><i></i></span>
          <div class="route-stop">
            <span class="route-icon route-icon--document">✓</span>
            <span>Connected</span>
          </div>
          <span class="route-line"><i></i></span>
          <div class="route-stop">
            <span class="route-icon">R</span>
            <span>Retailer</span>
          </div>
        </div>
      </div>
    </section>

    <section class="reach section" id="solutions" aria-labelledby="reach-title">
      <div class="section-heading reach-heading">
        <p class="section-intro">One connection replaces a patchwork of portals and point solutions.</p>
        <h2 id="reach-title">Connect once.<br />Reach everywhere.</h2>
      </div>
      <div class="reach-content">
        <p class="reach-lede">
          EDI Spark connects to more than 300 common SaaS products and the retailer networks your
          customers already depend on.
        </p>
        <div class="integration-list">
          {integrationGroups.map(([title, description]) => (
            <div class="integration-row">
              <span class="integration-symbol" aria-hidden="true"></span>
              <strong>{title}</strong>
              <span>{description}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="partner-network section" id="partners" aria-labelledby="partners-title">
      <div class="partner-network__heading">
        <p class="section-intro">A trading network you can join—not another connection you have to build.</p>
        <h2 id="partners-title">Your next trading partner may already be connected.</h2>
        <p>
          EDI Spark connects suppliers with hundreds of trading partners, including every major UK
          retailer. Start from an established network and get new relationships moving sooner.
        </p>
      </div>

      <div class="network-index" aria-label="EDI Spark network coverage">
        <div class="network-index__row">
          <span>Retail coverage</span>
          <strong>Every major UK retailer</strong>
          <p>Connect to the customers your business already supplies—or wants to supply next.</p>
        </div>
        <div class="network-index__row">
          <span>Trading community</span>
          <strong>Hundreds of partners</strong>
          <p>Reuse established connections instead of beginning each relationship from zero.</p>
        </div>
        <div class="network-index__row">
          <span>Faster onboarding</span>
          <strong>One managed network</strong>
          <p>Add retailer relationships without creating another long integration project.</p>
        </div>
      </div>
    </section>

    <section class="mapping section section--indigo" id="product" aria-labelledby="mapping-title">
      <div class="mapping-intro">
        <p class="section-intro">Retailer EDI, without the EDI work.</p>
        <h2 id="mapping-title">Spend less time moving documents. More time fulfilling orders.</h2>
        <p>
          EDI Spark handles the exchange in the background and gives your team a simple way to keep
          work moving.
        </p>
      </div>

      <div class="mapping-story" data-mapping-story>
        {mappingSteps.map((step, index) => (
          <article class="mapping-step" data-mapping-step data-active={index === 0 ? 'true' : 'false'}>
            <div class="mapping-copy">
              <span class="step-number">{index + 1}</span>
              <div>
                <p class="step-stage">{step.stage}</p>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </div>
            </div>
            <div class="outcome-example" aria-label={`${step.stage}: ${step.result}`}>
              <span class="outcome-document" aria-hidden="true"></span>
              <span><small>{step.item}</small><strong>{step.result}</strong></span>
              <span class="outcome-check" aria-hidden="true">✓</span>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="workspace section" aria-labelledby="workspace-title">
      <div class="workspace-copy">
        <p class="section-intro">A clear workspace for people who do not speak EDI.</p>
        <h2 id="workspace-title">See every document. Know what happens next.</h2>
        <p>
          Follow orders, invoices and responses from arrival to delivery. Problems are explained in
          plain English, with the context your team needs to resolve them.
        </p>
        <ul class="plain-list">
          <li>Unlimited users</li>
          <li>Technical support included</li>
          <li>Complete document visibility</li>
        </ul>
      </div>

      <div class="product-frame" aria-label="Example EDI Spark transaction workspace">
        <div class="product-bar">
          <span class="product-brand">EDI Spark</span>
          <span class="product-status"><i></i> All systems ready</span>
        </div>
        <div class="product-body">
          <div class="product-sidebar" aria-hidden="true">
            <span class="active"></span><span></span><span></span><span></span>
          </div>
          <div class="transaction-view">
            <div class="transaction-heading">
              <div>
                <span>Documents</span>
                <strong>Today’s exchange</strong>
              </div>
              <span class="filter-chip">All documents</span>
            </div>
            <div class="transaction-list">
              {transactions.map(([type, reference, status]) => (
                <div class="transaction-row">
                  <span class="document-glyph" aria-hidden="true"></span>
                  <span><strong>{type}</strong><small>{reference}</small></span>
                  <span class="transaction-status"><i></i>{status}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="outcomes section section--ink" id="outcomes" aria-labelledby="outcomes-title">
      <div class="outcomes-heading">
        <p class="section-intro">The outcome is less EDI work—not more software to manage.</p>
        <h2 id="outcomes-title">Make every retailer connection easier to run.</h2>
      </div>
      <div class="outcomes-list">
        {businessOutcomes.map(([title, body], index) => (
          <div class="outcome-row">
            <span>{index + 1}</span>
            <h3>{title}</h3>
            <p>{body}</p>
          </div>
        ))}
        <div class="developer-route" id="developers">
          <p><strong>Building a custom integration?</strong> Your technical team can go deeper with APIs, A2A and MCP.</p>
          <a class="text-arrow" href="/developers">
            Visit the developer platform <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <section class="pricing section" id="pricing" aria-labelledby="pricing-title">
      <div class="pricing-heading">
        <p class="section-intro">Simple and predictable pricing.</p>
        <h2 id="pricing-title">Pay for your mailbox. Then pay for what you exchange.</h2>
      </div>
      <div class="price-ledger">
        <div class="price-row">
          <span class="price-label">EDI Spark mailbox</span>
          <span class="price-value">{pricingDisplay.monthlyFee}</span>
          <span class="price-unit">per month</span>
        </div>
        <div class="price-row">
          <span class="price-label">Documents exchanged</span>
          <span class="price-value">{pricingDisplay.documentFee}</span>
          <span class="price-unit">per document</span>
        </div>
        <div class="price-includes">
          <span>No setup fee</span>
          <span>No 12-month contract</span>
          <span>Unlimited users</span>
          <span>Technical support</span>
        </div>
        <a class="button" href={trialUrl}>Start free for {pricing.standard.trialDays} days</a>
        <a class="text-arrow text-arrow--ink" href="/pricing">
          Estimate your monthly cost <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <section class="enterprise section section--indigo" aria-labelledby="enterprise-title">
      <div>
        <p class="section-intro">More volume. More connections. The same clear experience.</p>
        <h2 id="enterprise-title">Enterprise capability without enterprise friction.</h2>
      </div>
      <div class="enterprise-copy">
        <p>
          Larger suppliers and retailers can bring complex integration requirements to the same
          flexible foundation—without creating a separate world for everyday users.
        </p>
        <a class="button button--light" href={demoUrl}>Talk through your requirements</a>
      </div>
    </section>

    <section class="final-cta" id="start" aria-labelledby="final-title">
      <div class="final-cta__copy">
        <p class="section-intro">Your next retailer connection can be the easy one.</p>
        <h2 id="final-title">Make EDI effortless.</h2>
      </div>
      <div class="final-cta__actions">
        <a class="button button--ink" href={trialUrl}>Start free for {pricing.standard.trialDays} days</a>
        <a class="text-arrow text-arrow--ink" href={demoUrl}>Book a demo <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <a class="brand brand--footer" href="#top">EDI Spark</a>
    <p>Effortless EDI for suppliers connecting to retailers.</p>
    <div class="footer-links">
      <a href="https://example.com/edi-spark/privacy">Privacy</a>
      <a href="https://example.com/edi-spark/terms">Terms</a>
      <a href={signInUrl}>Sign in</a>
    </div>
  </footer>

  <script>
    const menuButton = document.querySelector('[data-menu-button]');
    const navigation = document.querySelector('[data-navigation]');

    const setMenu = (open) => {
      if (!(menuButton instanceof HTMLButtonElement) || !(navigation instanceof HTMLElement)) return;
      menuButton.setAttribute('aria-expanded', String(open));
      menuButton.querySelector('.sr-only').textContent = open ? 'Close navigation' : 'Open navigation';
      navigation.dataset.open = String(open);
      document.body.classList.toggle('menu-open', open);
    };

    menuButton?.addEventListener('click', () => {
      setMenu(menuButton.getAttribute('aria-expanded') !== 'true');
    });

    navigation?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));
    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setMenu(false);
    });

    const steps = [...document.querySelectorAll('[data-mapping-step]')];
    if ('IntersectionObserver' in window && steps.length) {
      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
          if (!visible) return;
          steps.forEach((step) => step.setAttribute('data-active', String(step === visible.target)));
        },
        { rootMargin: '-28% 0px -42%', threshold: [0.25, 0.55, 0.8] },
      );
      steps.forEach((step) => observer.observe(step));
    }
  </script>
</BaseLayout>
