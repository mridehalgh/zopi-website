---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { pricing, pricingDisplay } from '../config/pricing';
import { trialHref, trialLabel, demoHref, site } from '../config/site';
const steps = [
  { stage: 'Your retailers and software', title: 'Start with the connections you need.', body: 'Share your retailer requirements and the systems you use. We review document types, integration options and any work needed for your setup.', item: 'Retailer + business system', result: 'Scope the connection' },
  { stage: 'Mapping and testing', title: 'Agree who handles each step.', body: 'Confirm the mapping, configuration and retailer test requirements. You provide the account details and approvals; responsibilities and costs are agreed before work begins.', item: 'Documents + validation rules', result: 'Agree the test plan' },
  { stage: 'Approval and go-live', title: 'Check the exchange before switching on.', body: 'Review the test results and agree the cutover. Retailer approval and your internal systems can affect timing, so the go-live plan accounts for both.', item: 'Test results + retailer approval', result: 'Plan the live exchange' },
];
const transactions = [['Purchase order', 'PO-10482', 'Received'], ['Order response', 'OR-10482', 'Ready'], ['Invoice', 'INV-8821', 'Delivered']];
const faqs = [
  ['Do we need an EDI specialist?', 'The managed service is designed for supplier teams. We review your retailer requirements and agree who handles configuration, mapping and testing. Your team provides business decisions, access and approvals.'],
  ['Will it work with our retailers and software?', 'Start with the trading partner and integration directories, then ask us to confirm your specific route. A listing is a starting point for assessment; supported documents, software versions and delivery methods need to be checked.'],
  ['What happens during the trial?', `Ask about the ${pricing.standard.trialDays}-day trial when we review your connection. We confirm access, included work and usage, the start date, payment requirements and what happens at expiry before you begin.`],
  ['Can we move from another provider?', 'We can assess your existing routes and the work involved in moving them. Bring your partner list and contract dates so testing, retailer approvals and cutover responsibilities can be planned.'],
];
---
<BaseLayout title="EDI Spark — Retailer EDI for UK suppliers" description={`Receive retailer orders, send invoices and connect your business software. Standard pricing is ${pricingDisplay.monthlyFee}/month + ${pricingDisplay.documentFee}/document, excluding VAT.`}>
  <SiteHeader />
  <main id="main-content">
    <section class="hero" id="top" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="hero-context">Managed document exchange</p>
        <h1 id="hero-title">Retailer EDI for UK suppliers.</h1>
        <p class="hero-lede">Receive orders, send invoices and keep your business software in sync. EDI Spark manages the exchange so your team can focus on fulfilling orders.</p>
        <div class="button-group"><a class="button" href={trialHref} data-cta="trial">{trialLabel}</a><a class="button button--outline" href={demoHref} data-cta="demo">{site.bookingUrl ? 'Book a demo' : 'Discuss a demo'}</a></div>
        <p class="trial-note">{pricingDisplay.monthlyFee}/month + {pricingDisplay.documentFee}/document, excluding VAT.<br />Standard offer: setup included, no annual contract.</p>
        <a class="text-arrow text-arrow--ink" href="#how-it-works">See how getting connected works <span aria-hidden="true">↓</span></a>
      </div>
      <div class="hero-ledger" aria-label="Standard pricing, excluding VAT">
        <div class="ledger-pricing">
          <div class="ledger-row"><span class="ledger-value">{pricingDisplay.monthlyFee}</span><span class="ledger-unit">per month</span></div>
          <div class="ledger-row"><span class="ledger-value">+ {pricingDisplay.documentFee}</span><span class="ledger-unit">per document</span></div>
          <div class="ledger-row ledger-row--plain"><span class="ledger-value">£0</span><span class="ledger-unit">standard setup fee</span></div>
        </div>
        <div class="hero-route" aria-hidden="true"><div class="route-stop"><span class="route-icon">S</span><span>Supplier</span></div><span class="route-line"><i></i></span><div class="route-stop"><span class="route-icon route-icon--document">↔</span><span>Exchange</span></div><span class="route-line"><i></i></span><div class="route-stop"><span class="route-icon">R</span><span>Retailer</span></div></div>
      </div>
    </section>
    <section class="reach section" id="connections" aria-labelledby="reach-title">
      <div class="section-heading reach-heading"><p class="section-intro">Your trading relationships come first</p><h2 id="reach-title">Find your retailer.<br />Bring your software.</h2></div>
      <div class="reach-content"><p class="reach-lede">Tell us which customers you supply and where your orders need to go. We’ll review the connection method, document requirements and setup for your operation.</p>
        <div class="connection-paths"><a href="/partners"><strong>Trading partners</strong><span>Find a retailer and check your requirements</span><span aria-hidden="true">→</span></a><a href="/integrations"><strong>Business software</strong><span>Explore ERP, finance and warehouse systems</span><span aria-hidden="true">→</span></a></div>
        <p class="trial-note">Connection availability and scope are confirmed before onboarding.</p>
      </div>
    </section>
    <section class="workspace section" aria-labelledby="workspace-title">
      <div class="workspace-copy"><p class="section-intro">Follow the document, from order to invoice</p><h2 id="workspace-title">Know where the work stands.</h2><p>A shared view of orders, responses and invoices helps your team see what has arrived, what is ready and what needs attention.</p><p>Discuss your own workflow with us and ask to see the product steps relevant to your retailer and software.</p><a class="text-arrow text-arrow--ink" href={demoHref} data-cta="demo">Discuss your workflow <span aria-hidden="true">→</span></a></div>
      <figure class="workspace-example"><div class="product-frame" aria-label="Illustrative document workspace using sample data"><div class="product-bar"><span class="product-brand">EDI Spark</span><span>Sample workspace</span></div><div class="product-body"><div class="product-sidebar" aria-hidden="true"><span class="active"></span><span></span><span></span><span></span></div><div class="transaction-view"><div class="transaction-heading"><div><span>Documents</span><strong>Today’s exchange</strong></div><span class="filter-chip">All documents</span></div><div class="transaction-list">{transactions.map(([type, reference, status]) => <div class="transaction-row"><span class="document-glyph" aria-hidden="true"></span><span><strong>{type}</strong><small>{reference}</small></span><span class="transaction-status"><i></i>{status}</span></div>)}</div></div></div></div><figcaption>Illustrative workspace with sample data. Ask for a walkthrough of your proposed workflow.</figcaption></figure>
    </section>
    <section class="mapping section section--indigo" id="how-it-works" aria-labelledby="mapping-title">
      <div class="mapping-intro"><p class="section-intro">How getting connected works</p><h2 id="mapping-title">A clear path to your first exchange.</h2><p>From your retailer’s requirements to an agreed live connection, make the work and its owners clear at each stage.</p><a class="text-arrow" href="/guides/retailer-edi-onboarding">Read the onboarding checklist <span aria-hidden="true">→</span></a></div>
      <div class="mapping-story">{steps.map((step, index) => <article class="mapping-step" data-mapping-step data-active={index === 0 ? 'true' : 'false'}><div class="mapping-copy"><span class="step-number">{index + 1}</span><div><p class="step-stage">{step.stage}</p><h3>{step.title}</h3><p>{step.body}</p></div></div><div class="outcome-example"><span class="outcome-document" aria-hidden="true"></span><span><small>{step.item}</small><strong>{step.result}</strong></span><span aria-hidden="true">→</span></div></article>)}</div>
    </section>
    <section class="pricing section" id="pricing" aria-labelledby="pricing-title"><div class="pricing-heading"><p class="section-intro">A visible service fee and document rate</p><h2 id="pricing-title">Estimate the bill before you begin.</h2><p>Count the documents your workflow exchanges, including both directions. An order can generate several documents.</p></div><div class="price-ledger"><div class="price-row"><span class="price-label">Monthly service</span><span class="price-value">{pricingDisplay.monthlyFee}</span><span class="price-unit">per month</span></div><div class="price-row"><span class="price-label">Document usage</span><span class="price-value">{pricingDisplay.documentFee}</span><span class="price-unit">per document</span></div><div class="price-includes"><span>Standard setup included</span><span>No annual contract</span><span>Unlimited users</span><span>Technical support</span></div><p>Prices exclude VAT. Confirm your integration and support scope before starting.</p><a class="button" href="/pricing">Calculate your monthly cost</a></div></section>
    <section class="supplier-questions section" aria-labelledby="questions-title"><div class="section-heading"><p class="section-intro">Before you choose</p><h2 id="questions-title">Get the practical questions answered.</h2><p><a href="/security">Review security and service questions</a> or <a href="/contact">contact the EDI Spark team</a>.</p></div><div class="supplier-faqs">{faqs.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></section>
    <section class="enterprise section section--indigo" aria-labelledby="enterprise-title"><div><p class="section-intro">Larger networks and technical teams</p><h2 id="enterprise-title">Bring the whole operation into view.</h2></div><div class="enterprise-copy"><p>Review trading networks, ERP integrations, volumes and service requirements with your team. Build a technical and commercial scope around the work you need to do.</p><a class="button button--light" href="/enterprise">Explore enterprise EDI</a><a class="text-arrow" href="/developers">Technical evaluation and integrations <span aria-hidden="true">→</span></a></div></section>
    <section class="final-cta" aria-labelledby="final-title"><div class="final-cta__copy"><p class="section-intro">Your retailers. Your software. A clear next step.</p><h2 id="final-title">Let’s scope your first connection.</h2></div><div class="final-cta__actions"><a class="button button--ink" href={trialHref} data-cta="trial">{trialLabel}</a></div></section>
  </main><SiteFooter />
  <script>
    const steps = [...document.querySelectorAll('[data-mapping-step]')];
    if ('IntersectionObserver' in window && steps.length) {
      const observer = new IntersectionObserver((entries) => {
        const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (visible) steps.forEach((step) => step.setAttribute('data-active', String(step === visible.target)));
      }, { rootMargin: '-15% 0px -15%', threshold: [0.25, 0.55] });
      steps.forEach((step) => observer.observe(step));
    }
  </script>
</BaseLayout>
