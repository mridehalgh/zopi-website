---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../config/site';
import '../styles/ai.css';

const examples = [
  {
    id: 'order', label: 'Follow an order',
    question: 'Did we respond to purchase order PO-10482?',
    answer: 'Yes. We sent Order Response OR-10482, and there’s a delivery receipt for it.',
    followUp: 'Did the retailer accept it?',
    reply: 'There’s no acceptance on record yet. Open the response in EDI Spark if you need to check the history or follow up with the retailer.',
    sources: [['Order response', 'OR-10482 · Sent'], ['Delivery receipt', 'Recorded for OR-10482']],
  },
  {
    id: 'shortage', label: 'Find a shortage',
    question: 'What arrived short on PO-10482?',
    answer: 'Four units arrived short on the lines we can match. We sent 96 and the retailer recorded 92 received.',
    followUp: 'Which line should the warehouse check?',
    reply: 'Line 10 accounts for the four-unit gap. Line 20 has no matching receipt yet, so check that line separately.',
    sources: [['Despatch advice', 'PO-10482 · Line 10 · 96 units sent'], ['Goods receipt', 'PO-10482 · Line 10 · 92 units received']],
  },
  {
    id: 'invoice', label: 'Explain a balance',
    question: 'Why does this £240 invoice still show a balance?',
    answer: 'The retailer’s payment advice allocates £200 to the invoice. That leaves £40 unallocated in the records I can see.',
    followUp: 'Does that mean the £40 is unpaid?',
    reply: 'The payment advice shows what was allocated. Finance can check the bank or accounts to confirm what was paid.',
    sources: [['Invoice', 'INV-10482 · £240'], ['Payment advice', '£200 allocated to INV-10482']],
  },
  {
    id: 'readiness', label: 'Check before sending',
    question: 'Why won’t this B&Q acknowledgement send?',
    answer: 'B&Q needs your vendor number on the acknowledgement. That field is blank.',
    followUp: 'Can you help me fix it?',
    reply: 'Open the acknowledgement in EDI Spark, add your vendor number and check the updated document before sending.',
    sources: [['B&Q acknowledgement', 'Vendor number · Blank'], ['Readiness check', 'BQ_VENDOR_NUMBER_REQUIRED']],
  },
  {
    id: 'mapping', label: 'Test a mapping',
    question: 'Will this mapping return the right unit of measure?',
    answer: 'The preview returned “case” on line 1. Your test expected “each”.',
    followUp: 'Where should I look?',
    reply: 'Open the mapping revision used by this route. Check the unit of measure on line 1, then run the test again.',
    sources: [['Mapping preview', 'Line 1 · Case'], ['Expected result', 'Line 1 · Each']],
  },
  {
    id: 'draft', label: 'Prepare a response',
    question: 'Can you help me prepare a response for PO-10517?',
    answer: 'You can start a reply in EDI Spark with the values from PO-10517 already carried over.',
    followUp: 'What do I need to review?',
    reply: 'Check the copied quantities, prices and order references before you save or send the response.',
    sources: [['Source order', 'PO-10517'], ['Order Response', 'Ready to open for review']],
  },
  {
    id: 'transfer', label: 'Trace a transfer',
    question: 'Did file transfer TX-2407 go through?',
    answer: 'The latest delivery attempt has a file receipt. The retailer’s acceptance of the document is still unrecorded.',
    followUp: 'Where can I check the difference?',
    reply: 'Open the transfer for the receipt or the linked document to see whether the retailer accepted it.',
    sources: [['File transfer', 'TX-2407 · Receipt recorded'], ['Retailer acceptance', 'No record']],
  },
];
const orderExample = examples[0];

type Workflow = {
  id: string;
  label: string;
  title: string;
  inApp?: boolean;
  prompt: string;
  answer: string;
  next: string;
  record: string;
  section: string;
  figures?: boolean;
  rows: [string, string][];
  note?: string;
  focus: number;
  link: string;
};

const workflows: Workflow[] = [
  {
    id: 'order', label: 'Order responses', title: 'Know when to chase an order response',
    prompt: 'What happened after we sent OR-10482?',
    answer: 'There’s a delivery receipt for OR-10482. The retailer’s acceptance isn’t on record, so follow up if you need confirmation.',
    next: 'Check what’s been confirmed before you follow up with the retailer.',
    record: 'OR-10482', section: 'Order Response',
    rows: [['Order response', 'Sent'], ['Delivery receipt', 'Recorded'], ['Retailer acceptance', 'No record']],
    focus: 2, link: 'See what’s still outstanding',
  },
  {
    id: 'warehouse', label: 'Short deliveries', title: 'Find what arrived short',
    prompt: 'Which line came up short on PO-10482?',
    answer: 'Line 10 is four units short. You sent 96 across two shipments, and the retailer recorded 92. Line 20 still needs checking.',
    next: 'Give the warehouse the exact line to investigate, even when the order went out in several shipments.',
    record: 'PO-10482 · Line 10', section: 'Delivery records', figures: true,
    rows: [['Sent', '96'], ['Received', '92'], ['Short', '4']],
    note: 'Line 20 has no matching receipt.', focus: 2, link: 'See the shortfall on line 10',
  },
  {
    id: 'finance', label: 'Invoice balances', title: 'Explain what’s left on an invoice',
    prompt: 'Why is there still £40 against INV-10482?',
    answer: 'The retailer put £200 against the £240 invoice. The remaining £40 has no allocation in the payment advice.',
    next: 'Give finance the amount to check in your accounts before chasing payment.',
    record: 'INV-10482', section: 'Invoice and payment advice', figures: true,
    rows: [['Invoiced', '£240'], ['Allocated', '£200'], ['Unallocated', '£40']],
    note: 'Amounts from the retailer’s payment advice.', focus: 2, link: 'See the £40 difference',
  },
  {
    id: 'readiness', label: 'Blocked documents', title: 'See what’s stopping a document from sending',
    inApp: true, prompt: 'Why won’t this acknowledgement send?',
    answer: 'B&Q requires your vendor number and the field is blank. Fill it in and check the document again before sending.',
    next: 'Go straight to the field that needs fixing.',
    record: 'B&Q acknowledgement', section: 'Document check',
    rows: [['Status', 'Needs attention'], ['Vendor number', 'Missing'], ['Retailer requirement', 'Required']],
    focus: 1, link: 'See the missing field',
  },
  {
    id: 'mapping', label: 'Mapping checks', title: 'Check what a retailer will see',
    prompt: 'Run my sample through this mapping. Does line 1 come out in individual items?',
    answer: 'The test returned “Case” for line 1. Your sample expected “Each”. Check how the mapping handles the unit, then run it again.',
    next: 'Catch a wrong unit while you’re still testing.',
    record: 'Line 1 · Unit of measure', section: 'Mapping preview',
    rows: [['Expected', 'Each'], ['Preview result', 'Case'], ['Check', 'Values differ']],
    focus: 1, link: 'See what the preview returned',
  },
  {
    id: 'draft', label: 'Order drafts', title: 'Start a reply with the order details filled in',
    inApp: true, prompt: 'Help me prepare a response for this purchase order.',
    answer: 'Open the response in EDI Spark with the order details copied over. Check the quantities, prices and references before you save.',
    next: 'Start with the original order and keep the final review in your hands.',
    record: 'New Order Response', section: 'Documents',
    rows: [['Source order', 'PO-10517'], ['Order details', 'Copied from source'], ['Status', 'Review before saving']],
    focus: 1, link: 'See what carries over',
  },
  {
    id: 'transfer', label: 'File deliveries', title: 'Find out whether a file got there',
    prompt: 'Did transfer TX-2407 go through?',
    answer: 'There’s a receipt for the latest delivery attempt. You can open the linked document to look for the retailer’s reply.',
    next: 'Use the delivery record to see whether the file made it to the other end.',
    record: 'TX-2407', section: 'Transfer history',
    rows: [['Delivery attempt', 'Latest attempt'], ['File receipt', 'Recorded'], ['Document acceptance', 'No record']],
    focus: 1, link: 'See the delivery receipt',
  },
];
---

<BaseLayout
  title="AI for retailer EDI — EDI Spark"
  description="Ask your assistant what happened to a retailer order, why a document is blocked or where an AS2 transfer landed. Get answers grounded in EDI Spark records through MCP."
>
  <SiteHeader current="/ai" />
  <main id="main-content" class="ai-page">
    <section class="ai-lead" data-ai-demo aria-labelledby="ai-title">
      <header class="ai-lead__header">
        <h1 id="ai-title">Talk to your <em>EDI.</em></h1>
        <div>
          <p>Ask about an order, a delivery or an invoice. Start in EDI Spark or use a connected assistant like Claude or ChatGPT.</p>
          <a class="button" href="#connect-ai" data-cta="ai_connect">Connect your assistant</a>
        </div>
      </header>
      <div class="ai-demo__bar">
        <p>Example conversations</p>
        <button class="ai-demo__play" type="button" data-ai-play hidden>Pause examples</button>
      </div>
      <div class="ai-demo__stage" data-ai-stage>
        {examples.map(({ id, label, question, answer, sources, followUp, reply }) => (
          <article class="ai-exchange" id={`ai-case-${id}`} data-ai-case={id} data-ai-label={label} hidden={id !== 'shortage'} aria-label={`${label} example`}>
            <div class="ai-exchange__conversation">
              <h2>{question}</h2>
              <p class="ai-exchange__answer"><span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>{answer}</p>
              <p class="ai-exchange__follow">{followUp}</p>
              <p class="ai-exchange__reply">{reply}</p>
            </div>
            <div class="ai-exchange__visual">
              <aside class="ai-slip" aria-label="Illustrative source records">
                <h3>Source records</h3>
                <dl>{sources.map(([name, value]) => <div><dt>{name}</dt><dd>{value}</dd></div>)}</dl>
              </aside>
            </div>
          </article>
        ))}
      </div>
      <div class="ai-demo__controls" data-ai-controls hidden>
        <fieldset class="ai-demo__choices" data-ai-choices>
          <legend class="sr-only">Choose an example conversation</legend>
          {examples.map(({ id, label }) => (
            <label><input type="radio" name="ai-demo" value={id} checked={id === 'shortage'} aria-controls={`ai-case-${id}`} /><span>{label}</span></label>
          ))}
        </fieldset>
      </div>
      <p class="sr-only" role="status" data-ai-announcement></p>
    </section>

    <section class="ai-document-story" aria-labelledby="ai-document-title">
      <div class="ai-document-story__intro">
        <h2 id="ai-document-title">From the chat to the order.</h2>
        <p>Ask whether a response went out, then follow up on whether the retailer accepted it. The sample conversations point back to the same order in EDI Spark.</p>
      </div>
      <div class="ai-handoff" data-ai-handoff>
        <article class="ai-handoff__chat" aria-labelledby="ai-handoff-chat">
          <h3 id="ai-handoff-chat" class="ai-handoff__bar">ChatGPT <span>Example conversation</span></h3>
          <p class="ai-handoff__prompt">{orderExample.question}</p>
          <p>{orderExample.answer}</p>
          <a href="#ai-order-response" class="ai-handoff__source">
            Find OR-10482 in EDI Spark
          </a>
        </article>
        <article class="ai-handoff__chat ai-handoff__chat--claude" aria-labelledby="ai-handoff-claude">
          <h3 id="ai-handoff-claude" class="ai-handoff__bar">Claude <span>Example conversation</span></h3>
          <p class="ai-handoff__prompt">Has the retailer accepted OR-10482?</p>
          <p>There’s a delivery receipt for OR-10482. EDI Spark has no record of the retailer accepting the response yet.</p>
          <a href="#ai-retailer-acceptance" class="ai-handoff__source">Check acceptance in EDI Spark</a>
        </article>
        <article class="ai-handoff__workspace" aria-labelledby="ai-handoff-workspace">
          <h3 id="ai-handoff-workspace" class="ai-handoff__bar"><span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span> EDI Spark <span>Illustrative workspace</span></h3>
          <div class="ai-handoff__document">
            <p>Documents / Purchase orders</p>
            <h4 class="ai-handoff__title">PO-10482</h4>
            <dl>
              <div><dt>Purchase order</dt><dd>Received</dd></div>
              <div id="ai-order-response" tabindex="-1"><dt>Order response <span>OR-10482</span></dt><dd>Sent</dd></div>
              <div><dt>Delivery receipt</dt><dd>Recorded</dd></div>
              <div id="ai-retailer-acceptance" tabindex="-1"><dt>Retailer acceptance</dt><dd>No record</dd></div>
            </dl>
          </div>
        </article>
      </div>
    </section>

    <section class="ai-workflows ai-section" id="use-cases" aria-labelledby="ai-workflows-title">
      <div class="ai-workflows__intro">
        <h2 id="ai-workflows-title">What can you ask?</h2>
        <p>See how a question in ChatGPT or inside EDI Spark leads you to the right record. These examples use sample data.</p>
      </div>
      <nav class="ai-workflows__nav" aria-label="Jump to a use case">
        <ul>{workflows.map(({ id, label }) => <li><a href={`#workflow-${id}`}>{label}</a></li>)}</ul>
      </nav>
      <div class="ai-workflow-list">
        {workflows.map(({ id, title, inApp, prompt, answer, next, record, section, figures, rows, note, focus, link }) => (
          <article class="ai-workflow" id={`workflow-${id}`} aria-labelledby={`workflow-title-${id}`}>
            <header class="ai-workflow__intro">
              <h3 id={`workflow-title-${id}`}>{title}</h3>
              <p>{next}</p>
            </header>
            <div class:list={['ai-handoff ai-workflow__preview', { 'ai-workflow__preview--in-app': inApp }]}>
              <section class="ai-handoff__chat" aria-label={inApp ? 'In-app assistant example' : 'ChatGPT example'}>
                <header class="ai-handoff__bar">
                  <h4>{inApp ? 'In-app assistant' : 'ChatGPT'}</h4>
                  <button class="ai-workflow__copy" type="button" data-ai-copy hidden>Copy prompt</button>
                </header>
                <p class="ai-handoff__prompt" data-ai-prompt>{prompt}</p>
                <p>{answer}</p>
                <a href={`#workflow-source-${id}`} class="ai-handoff__source">{link}</a>
                <span class="sr-only" role="status" data-ai-copy-status></span>
              </section>
              <section class="ai-handoff__workspace" aria-label="EDI Spark example">
                <h4 class="ai-handoff__bar">
                  <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
                  EDI Spark <span>{section}</span>
                </h4>
                <div class="ai-handoff__document">
                  <p class="ai-handoff__title">{record}</p>
                  <dl class:list={{ 'ai-workflow__figures': figures }}>
                    {rows.map(([name, value], index) => (
                      <div id={index === focus ? `workflow-source-${id}` : undefined} tabindex={index === focus ? '-1' : undefined}>
                        <dt>{name}</dt><dd>{value}</dd>
                      </div>
                    ))}
                  </dl>
                  {note && <p class="ai-workflow__note">{note}</p>}
                </div>
              </section>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="ai-connect ai-section" id="connect-ai" aria-labelledby="ai-connect-title">
      <div class="ai-connect__intro">
        <h2 id="ai-connect-title">Connect your assistant</h2>
        <p>Give an approved assistant access to the EDI Spark records it needs. Your team reviews drafts and sends documents in EDI Spark.</p>
        <a class="button" href={site.signInUrl ?? '/contact?intent=technical'} data-cta="ai_setup">{site.signInUrl ? 'Sign in to EDI Spark' : 'Talk to us about setup'}</a>
      </div>
      <div class="ai-connect__content">
        <ol class="ai-connect__steps">
          <li><strong>Open AI in your workspace.</strong> Organisation admins and owners can find setup instructions there.</li>
          <li><strong>Connect an approved client.</strong> Choose the right organisation when you sign in and approve what the assistant can access.</li>
          <li><strong>Ask about an exchange.</strong> Start with a question about a document, an order or a delivery.</li>
        </ol>
        <details class="ai-connect__technical">
          <summary>Technical requirements</summary>
          <p>EDI Spark uses <a href="https://blog.modelcontextprotocol.io/posts/2026-07-28/">MCP 2026-07-28</a> over stateless Streamable HTTP. Clients must be registered in advance and use OAuth with S256 PKCE and the exact registered redirect URI.</p>
          <p>Access is scoped to document evidence, previews or AS2 evidence. Commercial reconciliation values require a separate grant. Exchange traces report transport receipt, functional acknowledgement and business acceptance separately. Bank settlement and ERP posting need evidence from those systems.</p>
        </details>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  const demo = document.querySelector<HTMLElement>('[data-ai-demo]');
  const choices = demo?.querySelector<HTMLFieldSetElement>('[data-ai-choices]');
  const cases = demo?.querySelectorAll<HTMLElement>('[data-ai-case]');
  const announcement = demo?.querySelector<HTMLElement>('[data-ai-announcement]');
  const stage = demo?.querySelector<HTMLElement>('[data-ai-stage]');
  const controls = demo?.querySelector<HTMLElement>('[data-ai-controls]');
  const play = demo?.querySelector<HTMLButtonElement>('[data-ai-play]');

  if (demo && choices && cases && announcement && stage && controls && play) {
    const inputs = [...choices.querySelectorAll<HTMLInputElement>('input')];
    const duration = 12000;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let playing = !reduced.matches;
    let visible = false;
    let hovered = false;
    let timer: number | undefined;
    demo.style.setProperty('--ai-cycle', `${duration}ms`);

    const showCase = (choice: HTMLInputElement, announce: boolean) => {
      choice.checked = true;
      demo.setAttribute('data-interacted', '');
      for (const example of cases) {
        example.hidden = example.dataset.aiCase !== choice.value;
        if (announce && !example.hidden) announcement.textContent = `${example.dataset.aiLabel} example shown.`;
      }
    };

    const schedule = () => {
      window.clearTimeout(timer);
      play.hidden = reduced.matches;
      play.textContent = playing ? 'Pause examples' : 'Play examples';
      play.toggleAttribute('data-playing', playing);
      const advancing = playing && visible && !hovered && !document.hidden;
      demo.toggleAttribute('data-advancing', advancing);
      if (!advancing) return;
      timer = window.setTimeout(() => {
        const current = inputs.findIndex(input => input.checked);
        showCase(inputs[(current + 1) % inputs.length], false);
        schedule();
      }, duration);
    };

    choices.addEventListener('change', event => {
      if (event.target instanceof HTMLInputElement) {
        playing = false;
        showCase(event.target, true);
        schedule();
      }
    });
    play.addEventListener('click', () => {
      playing = !playing;
      schedule();
    });
    demo.addEventListener('focusin', event => {
      if (event.target !== play && playing) {
        playing = false;
        schedule();
      }
    });
    stage.addEventListener('pointerenter', event => {
      if (event.pointerType === 'mouse') {
        hovered = true;
        schedule();
      }
    });
    stage.addEventListener('pointerleave', () => {
      hovered = false;
      schedule();
    });
    reduced.addEventListener('change', () => {
      if (reduced.matches) playing = false;
      schedule();
    });
    document.addEventListener('visibilitychange', schedule);
    new IntersectionObserver(([entry]) => {
      visible = entry.intersectionRatio >= .35;
      schedule();
    }, { threshold: .35 }).observe(stage);
    controls.hidden = false;
    schedule();
  }

  for (const sourceLink of document.querySelectorAll<HTMLAnchorElement>('.ai-handoff__source')) {
    const sourceRow = document.getElementById(sourceLink.hash.slice(1));
    if (!sourceRow) continue;
    sourceLink.addEventListener('click', event => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      sourceLink.closest('.ai-handoff')?.querySelector('[data-ai-found]')?.removeAttribute('data-ai-found');
      sourceRow.setAttribute('data-ai-found', '');
      sourceRow.focus({ preventScroll: true });
      sourceRow.scrollIntoView({ block: 'nearest' });
    });
  }

  if (navigator.clipboard?.writeText) {
    for (const workflow of document.querySelectorAll('.ai-workflow')) {
      const button = workflow.querySelector<HTMLButtonElement>('[data-ai-copy]');
      const prompt = workflow.querySelector('[data-ai-prompt]')?.textContent?.trim();
      const status = workflow.querySelector('[data-ai-copy-status]');
      if (!button || !prompt || !status) continue;
      button.hidden = false;
      button.addEventListener('click', async () => {
        status.textContent = '';
        try {
          await navigator.clipboard.writeText(prompt);
          status.textContent = 'Prompt copied.';
          button.textContent = 'Copied';
        } catch {
          status.textContent = 'Select the prompt text to copy it.';
          button.textContent = 'Try copying again';
        }
      });
    }
  }
</script>
