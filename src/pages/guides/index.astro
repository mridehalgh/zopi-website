---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import '../../styles/information.css';
import '../../styles/guides.css';
---
<BaseLayout title="Supplier EDI guides — costs and onboarding | EDI Spark" description="Plan retailer EDI with practical guides to document costs, connection requirements, testing and supplier onboarding.">
  <SiteHeader current="/guides" />
  <main id="main-content" class="information-page guide-page">
    <header class="information-hero">
      <div class="information-wrap">
        <h1>Supplier EDI guides</h1>
        <p class="information-lede">Practical starting points for suppliers choosing an EDI service. Use these guides to prepare your questions, estimate usage and agree the path to your first exchange.</p>
      </div>
    </header>
    <div class="information-wrap information-body">
      <div class="guide-index">
        <article>
          <a href="/guides/edi-costs">
            <h2>How EDI costs work</h2>
            <p>Understand the mailbox fee, count business documents and work through example monthly estimates.</p>
          </a>
        </article>
        <article>
          <a href="/guides/retailer-edi-onboarding">
            <h2>Retailer EDI onboarding checklist</h2>
            <p>Gather the information you need, agree responsibilities and understand what needs testing before going live.</p>
          </a>
        </article>
      </div>
      <aside class="guide-callout">
        <h2>Have a retailer or system in mind?</h2>
        <p>Find it in the <a href="/partners">trading partner directory</a> or <a href="/integrations">business systems directory</a>, then ask us to assess the requirements. A directory listing does not confirm a ready-made connection.</p>
        <a class="button" href="/contact?intent=connection">Discuss your connection</a>
      </aside>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
