---
import DirectoryDetail from '../../components/DirectoryDetail.astro';
import { directoryPages } from '../../data/directory-pages';

export function getStaticPaths() {
  return directoryPages.partners.map(page => ({ params: { slug: page.slug }, props: { page } }));
}
const { page } = Astro.props;
---
<DirectoryDetail page={page} />
