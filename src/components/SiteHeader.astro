---
import { site, trialHref } from '../config/site';
interface Props { current?: string }
const { current } = Astro.props;
const navigation = [
  ['AI for EDI', '/ai'],
  ['Trading partners', '/partners'],
  ['Integrations', '/integrations'],
  ['Pricing', '/pricing'],
  ['Enterprise', '/enterprise'],
  ['Developers', '/developers'],
];
---
<header class="site-header" data-header>
  <a class="brand" href="/" aria-label="EDI Spark home">
    <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
    <span>EDI Spark</span>
  </a>
  <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-navigation" data-menu-button>
    Menu
    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" aria-hidden="true"><path d="M1 5h14M1 11h14" /></svg>
  </button>
  <nav id="site-navigation" class="site-navigation" aria-label="Primary navigation" data-navigation>
    <div class="nav-links">
      {navigation.map(([label, href]) => <a href={href} aria-current={current === href ? 'page' : undefined}>{label}</a>)}
    </div>
    <div class="nav-actions">
      {site.signInUrl && <a class="text-link" href={site.signInUrl}>Sign in</a>}
      <a class="button button--compact" href={trialHref} data-cta="trial">{site.trialUrl ? 'Start free' : 'Let’s talk'}</a>
    </div>
  </nav>
</header>
<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const button = header?.querySelector<HTMLButtonElement>('[data-menu-button]');
  const navigation = header?.querySelector<HTMLElement>('[data-navigation]');
  if (header && button && navigation) {
    const setMenu = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      navigation.dataset.open = String(open);
    };
    button.addEventListener('click', () => setMenu(button.getAttribute('aria-expanded') !== 'true'));
    header.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
        setMenu(false);
        button.focus();
      }
    });
    window.matchMedia('(max-width: 65rem)').addEventListener('change', ({ matches }) => {
      if (matches && navigation.contains(document.activeElement)) button.focus();
      setMenu(false);
    });
    header.dataset.menuReady = '';
  }
</script>
